# Filled automatically by: npx @cometchat/skills-cli@3 auth login && npx @cometchat/skills-cli@3 provision run
# (writes .cometchat/config.json, which the server reads). Or set them here:
COMETCHAT_APP_ID=
COMETCHAT_REGION=
COMETCHAT_AUTH_KEY=

# Optional: REST API key (Dashboard → API & Auth Keys). Lets the AI agent's
# replies be persisted into the CometChat conversation as the agent user.
# (COMET_REST_KEY is accepted as an alias.)
COMETCHAT_REST_API_KEY=

# Optional LLM for the AI pair (falls back to an offline code reviewer).
# Priority when several keys are set: gemini > openai > anthropic. Override with:
# PAIRTICK_LLM=mock|gemini|openai|anthropic
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
